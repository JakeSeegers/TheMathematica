  "quests": {
    "find-ilse": {
      "title": "The Missing Ferryman",
      "text": "Ilse rowed east to the Old Quarry with the ferry lantern three nights ago and has not come back.",
      "stages": [
        {
          "id": "asked",
          "text": "Elder Wren asked me to find Ilse. The bridge on the Mill Road is out — Hollis the carpenter might help."
        },
        {
          "id": "planks",
          "text": "Hollis will mend the bridge, but the flood took his timber: he needs three oak planks from the stack by the east road."
        },
        {
          "id": "bridge",
          "text": "Hollis mended the bridge at the Wolf Ford. The Old Quarry lies beyond it."
        },
        {
          "id": "found",
          "text": "Ilse was on the quarry ledge, the lantern still burning. Time to bring her home."
        },
        {
          "id": "home",
          "text": "Ilse and the lantern are home. Millbrook has lit every window."
        }
      ],
      "goals": [
        {
          "text": "Oak planks for Hollis (${item:plank} of 3)",
